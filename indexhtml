        window.adminEndShift = function(carId, driverName) {
            if (confirm(`هل أنت متأكد من إنهاء الوردية الحالية للسائق (${driverName})؟`)) {
                const weekId = getSaturdayWeekId();
                const shiftData = window.appState.activeShifts[carId];
                const endTime = Date.now();
                const todayKey = new Date().toISOString().split('T')[0];
                
                let elapsedHours = 0;
                let startTime = Date.now();
                if (shiftData) {
                    startTime = (typeof shiftData === 'object' && shiftData !== null) ? shiftData.timestamp : (adminShiftStartTimes[driverName] || Date.now());
                    let diffSecs = Math.max(0, Math.floor((endTime - startTime) / 1000));
                    elapsedHours = diffSecs / 3600;
                }

                if (!window.appState.weeklyRecords[weekId]) window.appState.weeklyRecords[weekId] = {};
                if (!window.appState.weeklyRecords[weekId][driverName]) {
                    window.appState.weeklyRecords[weekId][driverName] = { hours: 0, advances: 0, rewards: 0, days: {} };
                }

                const driverRec = window.appState.weeklyRecords[weekId][driverName];
                driverRec.hours = (driverRec.hours || 0) + elapsedHours;
                
                if (!driverRec.days) driverRec.days = {};
                if (!driverRec.days[todayKey]) driverRec.days[todayKey] = {};
                driverRec.days[todayKey].endTime = endTime;
                driverRec.days[todayKey].status = 'present';
                if(!driverRec.days[todayKey].startTime) driverRec.days[todayKey].startTime = startTime;

                const updates = {};
                updates[`activeShifts/${carId}`] = null;
                updates[`weeklyRecords/${weekId}/${driverName}`] = driverRec;
                db.ref().update(updates);

                delete adminShiftStartTimes[driverName];
                alert(`✅ تم إنهاء وردية السائق (${driverName}) بنجاح وإضافة ساعات العمل لرصيده.`);
            }
        }

