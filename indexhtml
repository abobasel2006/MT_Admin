        window.adminAddTransaction = function(e) {
            e.preventDefault();
            const driverName = document.getElementById('adminDriverSelect').value;
            const actionType = document.getElementById('adminActionType').value;
            const amount = Number(document.getElementById('adminAmount').value) || 0;
            if (!driverName) return;

            const weekId = getSaturdayWeekId();
            const todayKey = new Date().toISOString().split('T')[0];
            if (!window.appState.weeklyRecords[weekId]) window.appState.weeklyRecords[weekId] = {};
            if (!window.appState.weeklyRecords[weekId][driverName]) {
                window.appState.weeklyRecords[weekId][driverName] = { hours: 0, advances: 0, rewards: 0, days: {} };
            }

            const rec = window.appState.weeklyRecords[weekId][driverName];
            if (actionType === 'hours') {
                rec.hours = (rec.hours || 0) + amount;
                if(!rec.days) rec.days = {};
                if(!rec.days[todayKey]) rec.days[todayKey] = { hours: 0 };
                rec.days[todayKey].hours = (rec.days[todayKey].hours || 0) + amount;
                rec.days[todayKey].status = 'present';
            } else if (actionType === 'deduct_hours') {
                rec.hours = Math.max(0, (rec.hours || 0) - amount);
            } else if (actionType === 'reward') {
                rec.rewards = (rec.rewards || 0) + amount;
            } else if (actionType === 'advance') {
                rec.advances = (rec.advances || 0) + amount;
            }

            db.ref('weeklyRecords').set(window.appState.weeklyRecords);
            document.getElementById('adminAmount').value = "";
            alert('تم تنفيذ العملية بنجاح!');
