        window.saveAttendanceChange = function(e) {
            e.preventDefault();
            const driverName = document.getElementById('attDriverName').value;
            const dateKey = document.getElementById('attDateSelect').value;
            const status = document.getElementById('attStatusSelect').value;
            const weekId = window.currentActiveWeek;

            if (!driverName || !dateKey) return;

            const updates = {};
            updates[`weeklyRecords/${weekId}/${driverName}/days/${dateKey}/status`] = status;
            
            if (status === 'present') {
                updates[`weeklyRecords/${weekId}/${driverName}/days/${dateKey}/startTime`] = Date.now();
            } else if (status === 'absent') {
                updates[`weeklyRecords/${weekId}/${driverName}/days/${dateKey}/startTime`] = null;
                updates[`weeklyRecords/${weekId}/${driverName}/days/${dateKey}/endTime`] = null;
            }

            db.ref().update(updates).then(() => {
                alert(`✅ تم تحديث حالة الحضور للسائق (${driverName}) بنجاح!`);
                closeModal('attendanceModal');
            });
