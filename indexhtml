                    const remoteRec = remoteRecords[weekId][driverName];
                    const localRec = (window.appState.weeklyRecords[weekId] && window.appState.weeklyRecords[weekId][driverName]) || { advances: 0 };
                    
                    if (remoteRec.advances > localRec.advances) {
                        const diff = remoteRec.advances - localRec.advances;
                        remoteRec.advances = localRec.advances;
                        
                        if (!window.appState.pendingAdvances[weekId]) window.appState.pendingAdvances[weekId] = {};
                        window.appState.pendingAdvances[weekId][driverName] = {
