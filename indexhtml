                    if (dayData && dayData.status === 'absent') {
                        statusLabel = '❌ غائب (معدّل)';
                        badgeColor = 'var(--accent-red)';
                    } else if (dayData && dayData.startTime) {
                        const start = formatTime(dayData.startTime);
                        const end = dayData.endTime ? formatTime(dayData.endTime) : 'قيد العمل';
                        timeText = `${start} ➔ ${end}`;
                        statusLabel = 'حاضر ✅';
                        badgeColor = 'var(--accent-green)';
                    } else {
                        if (day.dateKey < todayStr) {
                            statusLabel = '❌ غياب';
                            badgeColor = 'var(--accent-red)';
                        } else if (day.dateKey === todayStr) {
                            statusLabel = '⏳ اليوم الحالي';
                            badgeColor = 'var(--accent-amber)';
                        } else {
                            statusLabel = '⏳ قادم';
                            badgeColor = 'var(--text-sub)';
                        }
                    }

                    return `
                        <tr>
                            <td><b>${day.name}</b><br><span style="font-size:7px; color:var(--text-sub);">${day.dateKey}</span></td>
                            <td>${timeText}</td>
                            <td style="color:${badgeColor}; font-weight:800;">${statusLabel}</td>
                        </tr>
                    `;
                }).join('');

                return `
                    <div class="fin-row">
                        <div class="fin-row-top">
                            <div>
                                <span class="d-name">${d.name}</span>
                                <span id="${statusId}" class="status-pill status-off">⚪ في استراحة</span>
                                <span class="d-car">(${d.car} - ${d.shift})</span>
                            </div>
                            <div style="display:flex; align-items:center; gap:6px;">
                                <span id="${timerId}" class="live-timer-badge">⏱️ 00:00:00</span>
                                <button id="${endBtnId}" class="btn-end-shift" style="display:none;">🛑 إنهاء الوردية</button>
                            </div>
                        </div>

                        <div class="weekly-sched-container">
                            <div class="sched-title">
                                <span>📅 جدول الحضور والغياب الأسبوعي (${d.name})</span>
                                <button onclick="openAttendanceModal('${d.name}')" class="btn-edit-attendance">✏️ تعديل الحضور/الغياب</button>
                            </div>
                            <table class="sched-table">
                                <thead>
                                    <tr>
                                        <th>اليوم والتاريخ</th>
                                        <th>وقت (البداية ➔ النهاية)</th>
                                        <th>الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${daysTableRows}
                                </tbody>
                            </table>
                        </div>

                        <div class="fin-stats-grid">
                            <div class="fin-box"><p class="lbl">ساعات اليوم</p><p id="${todayHoursId}" class="val val-indigo">0 س</p></div>
                            <div class="fin-box"><p class="lbl">ساعات الأسبوع</p><p id="${weekHoursId}" class="val val-amber">0 س</p></div>
                            <div class="fin-box"><p class="lbl">الأجر</p><p id="${salaryId}" class="val val-green">${Math.round(initialSalary).toLocaleString()} ل.س</p></div>
                            <div class="fin-box"><p class="lbl">السلف</p><p class="val val-red">${(rec.advances || 0).toLocaleString()} ل.س</p></div>
                            <div class="fin-box"><p class="lbl">الصافي</p><p id="${netId}" class="val val-amber">${Math.round(netDue).toLocaleString()} ل.س</p></div>
                        </div>
                        <div class="odometer-box">
                            <div>
                                <span>بداية: <b>${rec.odoStart || 0}</b></span> | <span>نهاية: <b>${rec.odoEnd || 0}</b></span>
                                <br><span style="color:var(--accent-green); font-weight:bold;">المسافة: ${distance} كم</span>
                            </div>
                            <div style="display:flex; gap:4px; align-items:center;">
                                ${rec.odoStartImg ? `<button onclick="showImage('${rec.odoStartImg}')" style="background:var(--accent-amber); color:#000; border:none; padding:4px 8px; border-radius:4px; font-size:9px; font-weight:bold; cursor:pointer;">📷 صورة البداية</button>` : '<span style="font-size:9px; color:var(--text-sub);">لا توجد صورة بداية</span>'}
                                ${rec.odoEndImg ? `<button onclick="showImage('${rec.odoEndImg}')" style="background:var(--accent-amber); color:#000; border:none; padding:4px 8px; border-radius:4px; font-size:9px; font-weight:bold; cursor:pointer;">📷 صورة النهاية</button>` : '<span style="font-size:9px; color:var(--text-sub);">لا توجد صورة نهاية</span>'}
                            </div>
                        </div>
                        <div class="pay-salary-box">
                            <div>
                                <span style="font-size:10px; font-weight:700; color:${rec.paid ? 'var(--accent-green)' : 'var(--text-sub)'};">
                                    ${rec.paid ? '✅ تم إرسال الراتب (' + (rec.paidAmount || Math.round(netDue)).toLocaleString() + ' ل.س)' : '⏳ الراتب بانتظار التقبيض'}
                                </span>
                            </div>
                            <button onclick="paySalary('${d.name}', ${Math.round(netDue)})" class="btn-pay ${rec.paid ? 'paid' : ''}">
                                ${rec.paid ? 'تم التقبيض' : '💵 تقبيض الراتب'}
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
            
            updateLiveTimersAndSalaries();
        }

        window.showImage = function(base64Str) {
            const imgEl = document.getElementById('modalOdoImg');
            if (imgEl) imgEl.src = base64Str;
            openModal('imageModal');
        }

        window.openModal = function(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.add('active');
        }
        window.closeModal = function(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.remove('active');
        }
        window.switchTab = function(tab) {
            const tabFleet = document.getElementById('tabFleet');
            const tabSalary = document.getElementById('tabSalary');
            const tabFleetBtn = document.getElementById('tabFleetBtn');
            const tabSalaryBtn = document.getElementById('tabSalaryBtn');

            if (!tabFleet || !tabSalary || !tabFleetBtn || !tabSalaryBtn) return;

            tabFleet.classList.remove('active');
            tabSalary.classList.remove('active');
            tabFleetBtn.classList.remove('active');
            tabSalaryBtn.classList.remove('active');

            if (tab === 'fleet') {
                tabFleet.classList.add('active');
                tabFleetBtn.classList.add('active');
            } else {
                tabSalary.classList.add('active');
                tabSalaryBtn.classList.add('active');
            }
        }
    </script>
</body>
</html>
