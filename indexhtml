        function updateLiveTimersAndSalaries() {
            const weekData = window.appState.weeklyRecords[window.currentActiveWeek] || {};
            const drivers = getAllDrivers();

            drivers.forEach(d => {
                const rec = weekData[d.name] || { hours: 0, advances: 0, rewards: 0, days: {} };
                
                let isOnDuty = false;
                let activeCarId = null;
                Object.keys(window.appState.activeShifts).forEach(carId => {
                    let val = window.appState.activeShifts[carId];
                    let drv = (typeof val === 'object' && val !== null) ? val.driver : val;
                    if (drv === d.name) {
                        isOnDuty = true;
                        activeCarId = carId;
                    }
                });

                let liveSecs = 0;
                let shiftStartTime = null;
                if (isOnDuty) {
                    const shiftData = window.appState.activeShifts[activeCarId];
                    shiftStartTime = (typeof shiftData === 'object' && shiftData !== null) ? shiftData.timestamp : (rec.imgTimestamp || adminShiftStartTimes[d.name] || Date.now());
                    if (!adminShiftStartTimes[d.name]) adminShiftStartTimes[d.name] = shiftStartTime;
                    liveSecs = Math.max(0, Math.floor((Date.now() - shiftStartTime) / 1000));
                } else {
                    delete adminShiftStartTimes[d.name];
                }

                let totalHours = (rec.hours || 0) + (liveSecs / 3600);
                const todayKey = new Date().toISOString().split('T')[0];
                const todayStoredHours = (rec.days && rec.days[todayKey] && rec.days[todayKey].hours) || 0;
                let todayHours = todayStoredHours + (isOnDuty ? (liveSecs / 3600) : 0);
                
                let totalSecs = Math.floor(totalHours * 3600);

                const h = Math.floor(totalSecs / 3600);
                const m = Math.floor((totalSecs % 3600) / 60);
                const s = totalSecs % 60;

                const liveSalary = totalHours * HOURLY_RATE;
                const rewards = rec.rewards || 0;
                const netDue = liveSalary + rewards - (rec.advances || 0);

                const timerEl = document.getElementById(`timer_${d.name.replace(/\s+/g, '_')}`);
                const statusEl = document.getElementById(`status_${d.name.replace(/\s+/g, '_')}`);
                const endShiftBtnEl = document.getElementById(`end_btn_${d.name.replace(/\s+/g, '_')}`);
                const salaryEl = document.getElementById(`salary_${d.name.replace(/\s+/g, '_')}`);
                const rewardsEl = document.getElementById(`rewards_${d.name.replace(/\s+/g, '_')}`);
                const netEl = document.getElementById(`net_${d.name.replace(/\s+/g, '_')}`);
                const todayHoursEl = document.getElementById(`today_hours_${d.name.replace(/\s+/g, '_')}`);
                const weekHoursEl = document.getElementById(`week_hours_${d.name.replace(/\s+/g, '_')}`);

                if (timerEl) timerEl.innerText = `⏱️ ${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                if (statusEl) {
                    statusEl.className = isOnDuty ? "status-pill status-on" : "status-pill status-off";
                    statusEl.innerText = isOnDuty ? "🟢 في وردية" : "⚪ في استراحة";
                }
                if (endShiftBtnEl) {
                    if (isOnDuty && activeCarId) {
                        endShiftBtnEl.style.display = 'inline-flex';
                        endShiftBtnEl.setAttribute('onclick', `adminEndShift(${activeCarId}, '${d.name}')`);
                    } else {
                        endShiftBtnEl.style.display = 'none';
                    }
                }
                if (salaryEl) salaryEl.innerText = `${Math.round(liveSalary).toLocaleString()} ل.س`;
                if (rewardsEl) rewardsEl.innerText = `${rewards.toLocaleString()} ل.س`;
                if (netEl) netEl.innerText = `${Math.round(netDue).toLocaleString()} ل.س`;
                
                if (todayHoursEl) todayHoursEl.innerText = `${todayHours.toFixed(1)} س`;
                if (weekHoursEl) weekHoursEl.innerText = `${totalHours.toFixed(1)} س`;
            });
        }

